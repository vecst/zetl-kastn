<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zetl.Linux</AssemblyName>
    <RootNamespace>ZETL</RootNamespace>
    <!-- Wayland's dispatcher callback is an unmanaged function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zetl" />
    <InternalsVisibleTo Include="Zetl.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chordl\Chordl.csproj" />
    <ProjectReference Include="..\Zetl.Core\Zetl.Core.csproj" />
    <ProjectReference Include="..\Zetl.Runtime\Zetl.Runtime.csproj" />
  </ItemGroup>
</Project>
