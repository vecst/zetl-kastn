<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zetl.Tests</AssemblyName>
    <RootNamespace>ZETL.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.17" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\hotkeys.json"
          Link="hotkeys.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kastn.App\Kastn.App.csproj" />
    <ProjectReference Include="..\Chordl\Chordl.csproj" />
    <ProjectReference Include="..\Zetl.Contracts\Zetl.Contracts.csproj" />
    <ProjectReference Include="..\Zetl.Core\Zetl.Core.csproj" />
    <ProjectReference Include="..\Zetl.Runtime\Zetl.Runtime.csproj" />
  </ItemGroup>
</Project>
