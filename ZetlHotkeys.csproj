<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zetl</AssemblyName>
    <RootNamespace>ZETL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Chordl\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed the canonical hotkeys.json so a single-file publish always has a
         default config to fall back on, while still copying it next to the
         build/publish output as an editable external override. -->
    <None Remove="hotkeys.json" />
    <EmbeddedResource Include="hotkeys.json">
      <LogicalName>hotkeys.json</LogicalName>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Chordl\Chordl.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BoardForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="BoardForm.Designer.cs">
      <DependentUpon>BoardForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ProjectSetupForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ProjectSetupForm.Designer.cs">
      <DependentUpon>ProjectSetupForm.cs</DependentUpon>
    </Compile>
    <Compile Update="NoteCaptureForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="NoteCaptureForm.Designer.cs">
      <DependentUpon>NoteCaptureForm.cs</DependentUpon>
    </Compile>
    <Compile Update="CompileForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="CompileForm.Designer.cs">
      <DependentUpon>CompileForm.cs</DependentUpon>
    </Compile>
    <Compile Update="TextPromptForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="TextPromptForm.Designer.cs">
      <DependentUpon>TextPromptForm.cs</DependentUpon>
    </Compile>
    <Compile Update="BucketSettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="BucketSettingsForm.Designer.cs">
      <DependentUpon>BucketSettingsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="FirstRunForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FirstRunForm.Designer.cs">
      <DependentUpon>FirstRunForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
