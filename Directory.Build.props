<Project>
  <!-- Build every project into one shared output directory so the Zetl and Kastn
       executables and their shared dependencies sit side by side, the way an
       installed copy ships. Kastn then finds Zetl right next to it (no per-project
       bin hunting), and there is a single place to look for build output. It lives
       under the already git-ignored artifacts\ tree, alongside publish output.

       Each project keeps its own obj\ intermediate directory; only the final bin
       output is shared. Assembly names are unique (Zetl, Kastn, Zetl.Core, ...),
       so nothing collides in the flat directory. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- The release both apps report: file properties, crash reports, and the
         first line Zetl logs at startup (which also carries the commit). -->
    <Version>1.0.0-rc.2</Version>
  </PropertyGroup>
</Project>
