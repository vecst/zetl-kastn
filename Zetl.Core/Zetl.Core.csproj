<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zetl.Core</AssemblyName>
    <RootNamespace>ZETL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Platform hosts and tests consume these internal types directly rather
         than through a public API surface. -->
    <InternalsVisibleTo Include="Zetl" />
    <InternalsVisibleTo Include="Zetl.App" />
    <InternalsVisibleTo Include="Zetl.Runtime" />
    <InternalsVisibleTo Include="Zetl.Tests" />
    <InternalsVisibleTo Include="Kastn" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zetl.Contracts\Zetl.Contracts.csproj" />
  </ItemGroup>
</Project>
