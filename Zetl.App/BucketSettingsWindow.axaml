<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZETL.BucketSettingsWindow"
        Width="520" Height="460"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Title="Bucket Settings">
  <Grid Margin="{DynamicResource ZetlWindowPadding}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="Bucket name" />
    <TextBox Grid.Row="1" x:Name="bucketNameBox" Margin="0,4,0,0" />

    <TextBlock Grid.Row="2" Text="Default kind" Margin="0,10,0,4" />
    <ComboBox Grid.Row="3" x:Name="defaultKindBox"
              Width="160" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="4" Text="Default compile mode" Margin="0,10,0,4" />
    <ComboBox Grid.Row="5" x:Name="compileModeBox"
              Width="160" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="6" Text="TSV row length" Margin="0,10,0,4" />
    <NumericUpDown Grid.Row="7" x:Name="tsvRowLengthBox"
                   Width="100" HorizontalAlignment="Left"
                   Minimum="1" Maximum="1000" Increment="1" />

    <TextBlock Grid.Row="8"
               Text="Default starting text / TSV headers"
               Margin="0,10,0,4" />
    <TextBox Grid.Row="9" x:Name="defaultStartingTextBox"
             AcceptsReturn="True"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />

    <Grid Grid.Row="10" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="validationText"
                 Classes="validation"
                 VerticalAlignment="Center"
                 IsVisible="False"
                 Text="Name the bucket first." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="saveButton" Content="Save" Width="86" IsDefault="True" Classes="primary" />
        <Button x:Name="cancelButton" Content="Cancel" Width="86" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
