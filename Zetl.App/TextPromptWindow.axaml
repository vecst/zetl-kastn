<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZETL.TextPromptWindow"
        Width="360" Height="150"
        CanResize="False"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="{DynamicResource ZetlWindowPadding}" RowDefinitions="Auto,Auto,Auto">
    <TextBlock Grid.Row="0" x:Name="promptLabel" Margin="0,0,0,4" />
    <TextBox Grid.Row="1" x:Name="textBox" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="validationText"
                 Classes="validation"
                 VerticalAlignment="Center"
                 IsVisible="False"
                 Text="Enter a value first." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="okButton" Content="OK" MinWidth="80" IsDefault="True" Classes="primary" />
        <Button x:Name="cancelButton" Content="Cancel" MinWidth="80" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
