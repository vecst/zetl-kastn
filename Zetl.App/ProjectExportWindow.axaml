<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZETL.ProjectExportWindow"
        Width="460" Height="270"
        CanResize="False"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner"
        Title="Export Project">
  <Grid Margin="{DynamicResource ZetlWindowPadding}"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="Export project" Classes="heading" />
    <TextBlock Grid.Row="1" x:Name="projectNameText"
               Margin="0,4,0,14"
               Classes="muted"
               TextTrimming="CharacterEllipsis" />

    <RadioButton Grid.Row="2" x:Name="cleanExportButton"
                 Content="Clean copy for sharing"
                 IsChecked="True" />
    <TextBlock Grid.Row="3"
               Text="Removes application, process, and window-title metadata."
               Classes="muted"
               Margin="24,2,0,10"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="4">
      <RadioButton x:Name="archiveExportButton"
                   Content="Archive copy" />
      <TextBlock Text="Keeps the project’s private capture provenance."
                 Classes="muted"
                 Margin="24,2,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock x:Name="validationText"
                 Classes="validation"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 IsVisible="False" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="exportButton" Content="Export…" MinWidth="86"
                IsDefault="True" Classes="primary" />
        <Button x:Name="cancelButton" Content="Cancel" MinWidth="86" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
