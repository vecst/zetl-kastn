<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZETL.FirstRunWindow"
        Width="1080" Height="760"
        MinWidth="760" MinHeight="560"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        Title="How Zetl Works">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Margin="{DynamicResource ZetlWindowPadding}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock Text="Zetl is built on Chordl."
                   Classes="title" />

        <TextBlock TextWrapping="Wrap">
          Chordl adds a hold-chord interaction called a coldkey. Some commands,
          such as copy and cut, happen immediately and then watch for a hold.
          Others happen when the key is released. Tap Ctrl+V to paste normally;
          keep holding it to open Zetl's compile tools.
        </TextBlock>
        <TextBlock TextWrapping="Wrap">
          When Zetl launches without an active project, Ctrl+C and Ctrl+V behave
          normally. Held Ctrl+X can still create a quick note in Scratch without
          starting a full project.
        </TextBlock>

        <TextBlock Text="What each coldkey does"
                   Classes="heading"
                   Margin="0,4,0,0" />
        <TextBlock Text="Anytime means the hold works even with no active project."
                   Opacity="0.75" />

        <Border Classes="surface"
                BorderThickness="1">
          <Grid ColumnDefinitions="100,*,*,80"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <Border Grid.Row="0" Grid.ColumnSpan="4"
                    Background="{DynamicResource ZetlSurfaceAltBrush}" />

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Coldkey" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Tap" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Hold" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Anytime" FontWeight="Bold" Margin="8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+C" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Add highlighted text to the active bucket and clipboard." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Edit the copy before adding it, or open the Board when nothing was copied." TextWrapping="Wrap" Margin="8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+X" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Normal cut." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Quick note, defaulting to Scratch." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Yes" HorizontalAlignment="Center" Margin="8" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+V" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Pop the last item in Pop Mode, or paste the next item in Replay Mode." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Compile slips — or, with no active project and nothing to compile, pick a template (like Ctrl+T)." TextWrapping="Wrap" Margin="8" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+P" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Normal Ctrl+P." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Turn Pop Mode on or off for the active bucket." TextWrapping="Wrap" Margin="8" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+R" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Normal Ctrl+R." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="Turn Replay Mode on or off for the active bucket." TextWrapping="Wrap" Margin="8" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Ctrl+B" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Normal Ctrl+B." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="6" Grid.Column="2" Text="Open the Board." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="6" Grid.Column="3" Text="Yes" HorizontalAlignment="Center" Margin="8" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl+Z" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Normal undo." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="7" Grid.Column="2" Text="Undo the latest Zetl action for this lane." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="7" Grid.Column="3" Text="Yes" HorizontalAlignment="Center" Margin="8" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ctrl+T" FontWeight="Bold" Margin="8" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Normal Ctrl+T." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="8" Grid.Column="2" Text="Pick a template (Capture or Consumable) to start a fresh project. Arrow keys to choose, Ctrl+Enter to start." TextWrapping="Wrap" Margin="8" />
            <TextBlock Grid.Row="8" Grid.Column="3" Text="Yes" HorizontalAlignment="Center" Margin="8" />
          </Grid>
        </Border>

        <TextBlock Text="Compile" Classes="heading" />
        <TextBlock TextWrapping="Wrap">
          Hold Ctrl+V to gather slips, then copy, paste, or save the result into
          a bucket. Formatted mode groups slips under headings, Plain emits one
          slip per line, and TSV creates spreadsheet rows using the configured
          row length and optional header lines.
        </TextBlock>

        <TextBlock Text="Pop Mode" Classes="heading" />
        <TextBlock TextWrapping="Wrap">
          Pop Mode treats a plain paste as a one-off: after Ctrl+V pastes, Zetl
          removes the matching item from the active bucket. Hold Ctrl+P to toggle
          it.
        </TextBlock>

        <TextBlock Text="Replay Mode" Classes="heading" />
        <TextBlock TextWrapping="Wrap">
          Replay Mode pastes a bucket's slips in order. Each Ctrl+V uses the next
          item, archives it for review, and restores your own clipboard. When the
          bucket is empty, normal paste resumes.
        </TextBlock>

        <TextBlock Text="Templates" Classes="heading" />
        <TextBlock TextWrapping="Wrap">
          Hold Ctrl+T to start a project from any template — switch between Capture
          and Consumable in the picker, choose with the arrow keys, and press
          Ctrl+Enter to start (Escape cancels). A Consumable template begins
          replaying right away. New Project also offers a template picker, and you
          build and edit templates in Kastn, including from an existing project's
          structure.
        </TextBlock>

        <TextBlock Text="Two independent lanes" Classes="heading" />
        <TextBlock TextWrapping="Wrap">
          Ctrl+Shift provides a second lane with its own active project and
          bucket. Use Ctrl+Shift+B for its Board and the shifted versions of the
          other coldkeys. Both lanes share the one system clipboard.
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
          Ctrl+Enter accepts Zetl dialogs, Escape cancels them, and the tray menu
          contains the Board, notifications, settings, and this guide.
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="16,8,16,16">
      <Button x:Name="openBoardButton" Content="Open Board" Width="106" />
      <Button x:Name="gotItButton" Content="Got It" Width="86" IsDefault="True" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
