<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zetl</AssemblyName>
    <RootNamespace>ZETL</RootNamespace>
    <Product>Zetl</Product>
    <Description>Cross-platform Zetl tray application</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chordl\Chordl.csproj" />
    <ProjectReference Include="..\Zetl.Contracts\Zetl.Contracts.csproj" />
    <ProjectReference Include="..\Zetl.Core\Zetl.Core.csproj" />
    <ProjectReference Include="..\Zetl.Runtime\Zetl.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="..\hotkeys.json" />
    <EmbeddedResource Include="..\hotkeys.json">
      <LogicalName>hotkeys.json</LogicalName>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hotkeys.json</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>
