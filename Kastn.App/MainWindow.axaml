<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KASTN.MainWindow"
        Width="1380" Height="820"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="Kastn">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem x:Name="refreshMenuItem" Header="_Refresh" InputGesture="F5" />
        <MenuItem x:Name="closeProjectMenuItem" Header="_Close Project" InputGesture="Ctrl+W" />
        <MenuItem x:Name="deleteProjectMenuItem" Header="_Delete Project" />
        <Separator />
        <MenuItem x:Name="exitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="newSlipMenuItem" Header="_New Slip" InputGesture="Ctrl+N" />
        <Separator />
        <MenuItem x:Name="saveSlipMenuItem" Header="_Save Slip" InputGesture="Ctrl+S" />
        <MenuItem x:Name="deleteSlipMenuItem" Header="_Delete Slip" />
        <Separator />
        <MenuItem x:Name="focusSearchMenuItem" Header="_Find" InputGesture="Ctrl+F" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="viewerModeMenuItem" Header="_Edit View" InputGesture="Ctrl+Shift+E" />
        <Separator />
        <MenuItem x:Name="focusProjectsMenuItem" Header="Focus Project _Cards" />
        <MenuItem x:Name="focusBucketsMenuItem" Header="Focus _Buckets" />
        <MenuItem x:Name="focusSlipsMenuItem" Header="Focus _Main View" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="aboutMenuItem" Header="_About Kastn" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1"
            x:Name="offlineBanner"
            Background="{DynamicResource KastnOfflineBrush}"
            Padding="12,8"
            IsVisible="False">
      <TextBlock Foreground="#22180C"
                 FontWeight="SemiBold"
                 Text="Zetl is offline. Your last snapshot remains readable; editing resumes after reconnect." />
    </Border>

    <Grid Grid.Row="2" Margin="16">
      <Border Classes="surface" Padding="18">
        <Grid>
          <StackPanel x:Name="emptyState"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="Kastn" Classes="title" HorizontalAlignment="Center" />
            <TextBlock x:Name="emptyStateText"
                       Text="Connecting to Zetl..."
                       Classes="muted"
                       TextAlignment="Center"
                       MaxWidth="440" />
            <StackPanel x:Name="landingModeToggle"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,4,0,0"
                        IsVisible="False">
              <Button x:Name="landingProjectsButton"
                      Content="Projects"
                      Padding="16,5" />
              <Button x:Name="landingTemplatesButton"
                      Content="Templates"
                      Padding="16,5" />
              <Button x:Name="landingCreateButton"
                      Content="Create"
                      Padding="16,5" />
            </StackPanel>
            <StackPanel x:Name="landingTemplateTypeToggle"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,4,0,0"
                        IsVisible="False">
              <Button x:Name="landingCaptureButton"
                      Content="Capture"
                      Padding="16,5" />
              <Button x:Name="landingConsumableButton"
                      Content="Consumable"
                      Padding="16,5" />
            </StackPanel>
            <Button x:Name="landingNewTemplateButton"
                    Content="+ New Template"
                    Padding="16,5"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    IsVisible="False"
                    Click="OnNewTemplateClick" />
            <Button x:Name="landingNewCreationButton"
                    Content="+ New Creation Type"
                    Padding="16,5"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    IsVisible="False"
                    Click="OnNewCreationClick" />
            <ListBox x:Name="landingProjectList"
                     Width="880"
                     MaxHeight="520"
                     Margin="0,16,0,0"
                     IsVisible="False">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="surface"
                          Width="450"
                          Height="330"
                          Padding="16"
                          Margin="8">
                    <Grid RowDefinitions="170,*,Auto">
                      <Border Grid.Row="0"
                              Background="{DynamicResource ZetlSurfaceAltBrush}"
                              CornerRadius="4"
                              Padding="14">
                        <TextBlock Text="{Binding PreviewText}"
                                   Classes="muted"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxLines="7" />
                      </Border>
                      <StackPanel Grid.Row="1"
                                  Margin="0,14,0,0"
                                  Spacing="5">
                        <TextBlock
                                 Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="20"
                                 TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   Classes="muted"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxLines="1" />
                        <TextBlock Text="{Binding ActivityText}"
                                   Classes="muted"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxLines="1" />
                      </StackPanel>
                      <Grid Grid.Row="2"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Content="Open"
                                Padding="14,5"
                                HorizontalAlignment="Left"
                                PointerPressed="OnProjectCardActionPointerPressed"
                                Click="OnProjectCardOpenClick" />
                        <Button Grid.Column="1"
                                Content="Rename"
                                Padding="14,5"
                                PointerPressed="OnProjectCardActionPointerPressed"
                                Click="OnProjectCardRenameClick" />
                        <Button Grid.Column="2"
                                Content="Delete"
                                Padding="14,5"
                                PointerPressed="OnProjectCardActionPointerPressed"
                                Click="OnProjectCardDeleteClick" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- An ItemsControl, not a ListBox: template cards act through their
                 Use Template button, so the cards must never show selection or
                 focus chrome. -->
            <ScrollViewer x:Name="landingTemplateList"
                          Width="880"
                          MaxHeight="520"
                          Margin="0,16,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False">
              <ItemsControl x:Name="landingTemplateItems">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="surface"
                            Width="450"
                            Height="330"
                            Padding="16"
                            Margin="8">
                      <Grid RowDefinitions="170,*,Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource ZetlSurfaceAltBrush}"
                                CornerRadius="4"
                                Padding="14">
                          <TextBlock Text="{Binding Kind}"
                                     Classes="muted"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="20"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                          <Button Content="Edit"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnEditTemplateClick" />
                          <Button Content="Duplicate"
                                  Padding="12,5"
                                  Click="OnDuplicateTemplateClick" />
                          <Button Content="Delete"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnDeleteTemplateClick" />
                          <Button Content="Use"
                                  Padding="12,5"
                                  Click="OnUseTemplateClick" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="landingCreationList"
                          Width="880"
                          MaxHeight="520"
                          Margin="0,16,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False">
              <ItemsControl x:Name="landingCreationItems">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="surface"
                            Width="450"
                            Height="330"
                            Padding="16"
                            Margin="8">
                      <Grid RowDefinitions="170,*,Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource ZetlSurfaceAltBrush}"
                                CornerRadius="4"
                                Padding="14">
                          <TextBlock Text="{Binding Kind}"
                                     Classes="muted"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="20"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                          <Button Content="Edit"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnEditCreationClick" />
                          <Button Content="Duplicate"
                                  Padding="12,5"
                                  Click="OnDuplicateCreationClick" />
                          <Button Content="Delete"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnDeleteCreationClick" />
                          <Button Content="Use"
                                  Padding="12,5"
                                  Click="OnUseCreationClick" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <Grid x:Name="projectView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,14,Auto,14,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0"
                         x:Name="projectTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      x:Name="saveAsTemplateButton"
                      Content="Save as Template"
                      Padding="14,5" />
              <Button Grid.Column="2"
                      x:Name="closeProjectButton"
                      Content="Close Project"
                      Padding="14,5" />
            </Grid>
            <TextBlock Grid.Row="1"
                       x:Name="projectSummary"
                       Classes="muted"
                       Margin="0,4,0,0" />

            <Grid Grid.Row="3" ColumnDefinitions="2*,12,*,12,*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Search" Classes="muted" FontSize="12" />
                <TextBox x:Name="searchBox" Watermark="Search slip text" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Source" Classes="muted" FontSize="12" />
                <ComboBox x:Name="sourceFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Session" Classes="muted" FontSize="12" />
                <ComboBox x:Name="sessionFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="6" Spacing="4">
                <TextBlock Text="Captured" Classes="muted" FontSize="12" />
                <ComboBox x:Name="dateFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="5" ColumnDefinitions="260,8,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Text="Buckets" Classes="heading" Margin="0,0,0,8" />
                  <ListBox Grid.Row="1" x:Name="bucketList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   Margin="4,5"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBox Grid.Row="2"
                           x:Name="bucketNameBox"
                           Watermark="Bucket name"
                           Margin="0,10,0,0" />
                  <ComboBox Grid.Row="3"
                            x:Name="parentBucketBox"
                            Margin="0,8,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="4"
                             x:Name="parentBucketHintText"
                             Classes="muted"
                             FontSize="12"
                             Margin="0,4,0,0" />
                  <Grid Grid.Row="5"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="6"
                        Margin="0,8,0,0">
                    <Button Grid.Column="0" x:Name="addBucketButton" Content="Add" />
                    <Button Grid.Column="1" x:Name="saveBucketButton" Content="Save" />
                    <Button Grid.Column="2" x:Name="deleteBucketButton" Content="Delete" />
                  </Grid>
                </Grid>
              </Border>

              <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

              <Border Grid.Column="2"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid>
                  <Grid x:Name="editorPanel"
                        IsVisible="False"
                        RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Editor" Classes="heading" />
                    <TextBlock Grid.Row="1"
                               x:Name="slipMetadataText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,2,0,8" />
                    <TextBox Grid.Row="2"
                             x:Name="slipEditor"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsEnabled="False" />
                    <Border Grid.Row="3"
                            x:Name="conflictPanel"
                            IsVisible="False"
                            BorderBrush="{DynamicResource KastnOfflineBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,0">
                      <Grid RowDefinitions="Auto,Auto,90,Auto,90,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="This slip changed in Zetl while you were editing."
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Your version" Classes="muted" Margin="0,8,0,3" />
                        <TextBox Grid.Row="2"
                                 x:Name="localConflictText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Current Zetl version" Classes="muted" Margin="0,8,0,3" />
                        <TextBox Grid.Row="4"
                                 x:Name="remoteConflictText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,8,0,0">
                          <Button x:Name="useZetlButton" Content="Use Zetl Version" />
                          <Button x:Name="keepMineButton" Content="Keep Mine" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Grid Grid.Row="4"
                          ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          Margin="0,10,0,0">
                      <ComboBox Grid.Column="0" x:Name="moveBucketBox">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" x:Name="moveSlipButton" Content="Move" />
                      <Button Grid.Column="2" x:Name="restoreSlipButton" Content="Restore" />
                      <Button Grid.Column="3" x:Name="deleteSlipButton" Content="Delete" />
                      <Button Grid.Column="4" x:Name="saveSlipButton" Content="Save" />
                    </Grid>
                  </Grid>
                  <Grid x:Name="viewerPanel"
                        RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,190,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Column="0"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <TextBlock Text="View" Classes="heading" VerticalAlignment="Center" />
                        <ComboBox x:Name="viewPickerBox" Width="150" VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="copyViewButton" Content="Copy" Padding="12,3" VerticalAlignment="Center" />
                        <Button x:Name="exportViewButton" Content="Export…" Padding="12,3" VerticalAlignment="Center" />
                        <Button x:Name="manageViewsButton" Content="Manage ▾" Padding="12,3" VerticalAlignment="Center">
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem x:Name="newViewMenuItem" Header="New view…" />
                              <MenuItem x:Name="editViewSettingsMenuItem" Header="Edit view…" />
                              <MenuItem x:Name="deleteViewMenuItem" Header="Delete view" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <ComboBox Grid.Column="1"
                                x:Name="editViewMoveBucketBox"
                                IsVisible="False">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="2"
                              x:Name="moveSelectedViewButton"
                              Content="Move Selected"
                              Padding="12,3" />
                      <Button Grid.Column="3"
                              x:Name="newSlipButton"
                              Content="New"
                              Padding="12,3" />
                      <Button Grid.Column="4"
                              x:Name="editViewButton"
                              Content="Edit View"
                              Padding="12,3" />
                      <Button Grid.Column="5"
                              x:Name="saveViewButton"
                              Content="Save All"
                              Padding="12,3" />
                      <Button Grid.Column="6"
                              x:Name="cancelViewButton"
                              Content="Cancel"
                              Padding="12,3" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               x:Name="viewerSummaryText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,2,0,8" />
                    <TextBlock Grid.Row="2"
                               x:Name="editViewStatusText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,8,310">
                      <Grid Grid.Column="0">
                        <TextBox x:Name="viewerTextBox"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <ScrollViewer x:Name="viewerDocumentScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto">
                          <StackPanel x:Name="viewerDocumentPanel" Spacing="12" Margin="8" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="editViewScroll"
                                      IsVisible="False"
                                      VerticalScrollBarVisibility="Auto">
                          <StackPanel x:Name="editableBlocksPanel" Spacing="10" />
                        </ScrollViewer>
                      </Grid>
                      <GridSplitter Grid.Column="1"
                                    Width="8"
                                    ResizeDirection="Columns" />
                      <Border Grid.Column="2"
                              Classes="surface"
                              Padding="12">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Grid.Row="0"
                                     Text="Slip details"
                                     Classes="heading" />
                          <ComboBox Grid.Row="1"
                                    x:Name="inspectorSlipBox"
                                    Margin="0,8,0,10">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ScrollViewer Grid.Row="2"
                                        VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="slipInspectorFieldsPanel"
                                        Spacing="8" />
                          </ScrollViewer>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                  <ListBox x:Name="slipList"
                           IsVisible="False"
                           SelectionMode="Multiple" />
                  <TextBlock x:Name="slipCountText" IsVisible="False" />
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="templateEditorView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,14,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="templateEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      x:Name="saveTemplateButton"
                      Content="Save Template"
                      Padding="14,5" />
              <Button Grid.Column="2"
                      x:Name="cancelTemplateButton"
                      Content="Cancel"
                      Padding="14,5" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="2*,12,*,12,Auto" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Template name" Classes="muted" FontSize="12" />
                <TextBox x:Name="templateNameBox" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Category" Classes="muted" FontSize="12" />
                <TextBox x:Name="templateCategoryBox" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Type" Classes="muted" FontSize="12" />
                <ComboBox x:Name="templateTypeBox" Width="150" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Description" Classes="muted" FontSize="12" />
              <TextBox x:Name="templateDescriptionBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Height="48" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       x:Name="templateErrorText"
                       Foreground="#E5484D"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />

            <Grid Grid.Row="5" ColumnDefinitions="260,8,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Row="0" Text="Buckets" Classes="heading" Margin="0,0,0,8" />
                  <ListBox Grid.Row="1" x:Name="templateBucketList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   Margin="4,5"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid Grid.Row="2"
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="6"
                        Margin="0,8,0,0">
                    <Button Grid.Column="0" x:Name="templateAddBucketButton" Content="Add" />
                    <Button Grid.Column="1" x:Name="templateBucketUpButton" Content="↑" />
                    <Button Grid.Column="2" x:Name="templateBucketDownButton" Content="↓" />
                    <Button Grid.Column="3" x:Name="templateDeleteBucketButton" Content="Del" />
                  </Grid>
                </Grid>
              </Border>

              <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

              <Border Grid.Column="2"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid>
                  <TextBlock x:Name="templateBucketEmptyHint"
                             Classes="muted"
                             Text="Add or select a bucket to edit its settings."
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                  <Grid x:Name="templateBucketEditor"
                        IsVisible="False"
                        RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Bucket" Classes="heading" />
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                      <TextBlock Text="Bucket name" Classes="muted" FontSize="12" />
                      <TextBox x:Name="templateBucketNameBox" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*,12,Auto" Margin="0,8,0,0">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Kind" Classes="muted" FontSize="12" />
                        <ComboBox x:Name="templateBucketKindBox" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Compile mode" Classes="muted" FontSize="12" />
                        <ComboBox x:Name="templateBucketCompileBox" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="TSV rows" Classes="muted" FontSize="12" />
                        <NumericUpDown x:Name="templateBucketTsvBox"
                                       Minimum="1"
                                       Maximum="100"
                                       Increment="1"
                                       FormatString="0"
                                       Width="120" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                      <TextBlock Text="Starting text / TSV headers (one per line)"
                                 Classes="muted"
                                 FontSize="12" />
                      <TextBox x:Name="templateBucketStartBox"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Height="70" />
                    </StackPanel>
                    <StackPanel Grid.Row="4"
                                x:Name="templateSeedsPanel"
                                Spacing="4"
                                Margin="0,10,0,0">
                      <TextBlock Text="Seeds — one per line (replayed in order)"
                                 Classes="muted"
                                 FontSize="12" />
                      <TextBox x:Name="templateBucketSeedsBox"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="viewEditorView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="viewEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="saveViewSettingsButton" Content="Save View" Padding="14,5" />
              <Button Grid.Column="2" x:Name="cancelViewSettingsButton" Content="Cancel" Padding="14,5" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="View name" Classes="muted" FontSize="12" />
              <TextBox x:Name="viewNameBox" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Category" Classes="muted" FontSize="12" />
                <TextBox x:Name="viewCategoryBox" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Kind" Classes="muted" FontSize="12" />
                <ComboBox x:Name="viewKindBox" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" x:Name="viewTsvPanel" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="TSV rows per line" Classes="muted" FontSize="12" />
              <NumericUpDown x:Name="viewTsvRowBox"
                             Minimum="1"
                             Maximum="100"
                             Increment="1"
                             FormatString="0"
                             Width="160"
                             HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Description" Classes="muted" FontSize="12" />
              <TextBox x:Name="viewDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Sections (optional)" Classes="muted" FontSize="12" />
              <TextBox x:Name="viewSectionsBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Height="96"
                       Watermark="One per line:  Heading = Bucket, Bucket. Leave empty to render every bucket." />
            </StackPanel>

            <TextBlock Grid.Row="6"
                       x:Name="viewErrorText"
                       Foreground="#E5484D"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />

            <TextBlock Grid.Row="7"
                       Classes="muted"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Views render the current project's slips. Slips stay the source of truth; a view never changes them." />
          </Grid>

          <Grid x:Name="creationEditorView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="creationEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="saveCreationButton" Content="Save" Padding="14,5" />
              <Button Grid.Column="2" x:Name="cancelCreationButton" Content="Cancel" Padding="14,5" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Creation type name" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationNameBox" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Category" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationCategoryBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Template" Classes="muted" FontSize="12" />
              <ComboBox x:Name="creationTemplateBox" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Default view" Classes="muted" FontSize="12" />
              <ComboBox x:Name="creationViewBox" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Description" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            </StackPanel>

            <TextBlock Grid.Row="6"
                       x:Name="creationErrorText"
                       Foreground="#E5484D"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            BorderBrush="{DynamicResource ZetlBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,9">
      <Grid ColumnDefinitions="Auto,8,*,Auto">
        <Ellipse Grid.Column="0"
                 x:Name="connectionIndicator"
                 Width="9" Height="9"
                 Fill="{DynamicResource KastnOfflineBrush}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   x:Name="statusText"
                   Text="Connecting to Zetl..."
                   Classes="muted"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Column="3"
                     x:Name="connectionProgress"
                     Width="90"
                     IsIndeterminate="True"
                     ShowProgressText="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
