<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KASTN.MainWindow"
        Width="1380" Height="820"
        MinWidth="1180" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="Kastn">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem x:Name="refreshMenuItem" Header="_Refresh" InputGesture="F5" />
        <MenuItem x:Name="saveAsTemplateMenuItem" Header="Save as _Template…" />
        <MenuItem x:Name="journalModeMenuItem" Header="_Journal Mode" ToggleType="CheckBox" />
        <MenuItem x:Name="closeProjectMenuItem" Header="_Close Project" InputGesture="Ctrl+W" />
        <MenuItem x:Name="deleteProjectMenuItem" Header="_Delete Project" />
        <Separator />
        <MenuItem x:Name="exitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="newSlipMenuItem" Header="_New Slip" InputGesture="Ctrl+N" />
        <Separator />
        <MenuItem x:Name="saveSlipMenuItem" Header="_Save Slip" InputGesture="Ctrl+S" />
        <MenuItem x:Name="deleteSlipMenuItem" Header="_Delete Slip" />
        <Separator />
        <MenuItem x:Name="focusSearchMenuItem" Header="_Find" InputGesture="Ctrl+F" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="focusProjectsMenuItem" Header="Focus Project _Cards" />
        <MenuItem x:Name="focusBucketsMenuItem" Header="Focus _Buckets" />
        <MenuItem x:Name="focusSlipsMenuItem" Header="Focus _Main View" />
        <Separator />
        <MenuItem x:Name="boardModeMenuItem" Header="_Board Mode" ToggleType="CheckBox" InputGesture="Ctrl+B" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="aboutMenuItem" Header="_About Kastn" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1"
            x:Name="offlineBanner"
            Background="{DynamicResource KastnOfflineBrush}"
            Padding="12,8"
            IsVisible="False">
      <TextBlock Foreground="#22180C"
                 FontWeight="SemiBold"
                 Text="Zetl is offline. Your last snapshot remains readable; editing resumes after reconnect." />
    </Border>

    <Grid Grid.Row="2" Margin="16">
      <Border Classes="surface" Padding="18">
        <Grid>
          <Grid x:Name="emptyState"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ColumnDefinitions="370,18,*"
                IsVisible="False">
            <Grid Grid.Column="0"
                  x:Name="landingProjectsPanel"
                  RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="12"
                  Focusable="True"
                  IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0"
                             Text="Kastn"
                             FontSize="22"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             x:Name="emptyStateText"
                             Text="Connecting to Zetl..."
                             Classes="muted"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              x:Name="landingLaneItems">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Height="142"
                              Margin="0,4"
                              Padding="0">
                        <Grid>
                          <Button Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Tag="{Binding Project}"
                                  IsVisible="{Binding HasProject}"
                                  IsEnabled="{Binding HasProject}"
                                  Click="OnProjectCardOpenClick">
                            <Border Classes="surface"
                                    Height="116"
                                    Padding="12"
                                    Opacity="0.86">
                              <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Label}"
                                           Classes="muted"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Spacing="5">
                                  <TextBlock Text="{Binding ProjectName}"
                                             FontWeight="SemiBold"
                                             FontSize="16"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding ProjectDetail}"
                                             Classes="muted"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             MaxLines="1" />
                                  <TextBlock Text="{Binding ProjectPreview}"
                                             Classes="muted"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             MaxLines="1" />
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding ProjectActivity}"
                                           Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxLines="1" />
                              </Grid>
                            </Border>
                          </Button>

                          <Border Classes="surface"
                                  Height="116"
                                  Padding="12"
                                  VerticalAlignment="Bottom"
                                  IsVisible="{Binding IsEmpty}"
                                  Opacity="0.72">
                            <Grid RowDefinitions="Auto,*,Auto">
                              <TextBlock Grid.Row="0"
                                         Text="{Binding Label}"
                                         Classes="muted"
                                         FontSize="12"
                                         FontWeight="SemiBold" />
                              <StackPanel Grid.Row="1"
                                          Margin="0,10,0,0"
                                          Spacing="5">
                                <TextBlock Text="{Binding EmptyTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EmptyDetail}"
                                           Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxLines="2" />
                              </StackPanel>
                              <TextBlock Grid.Row="2"
                                         Text="Use Set Active from a project card."
                                         Classes="muted"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         MaxLines="1" />
                            </Grid>
                          </Border>

                          <Button Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Width="340"
                                  Tag="{Binding OverlayProject}"
                                  IsVisible="{Binding HasOverlay}"
                                  Click="OnProjectCardOpenClick">
                            <Border Classes="surface"
                                    BorderBrush="{DynamicResource ZetlAccentBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    Height="112">
                              <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                  <TextBlock Grid.Column="0"
                                             Text="Queue"
                                             Classes="muted"
                                             FontSize="12"
                                             FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1"
                                             Text="Temporary"
                                             Classes="muted"
                                             FontSize="12"
                                             FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="2"
                                             Text="{Binding Label}"
                                             Classes="muted"
                                             FontSize="12"
                                             FontWeight="SemiBold" />
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Spacing="5">
                                  <TextBlock Text="{Binding OverlayName}"
                                             FontWeight="SemiBold"
                                             FontSize="16"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding OverlayDetail}"
                                             Classes="muted"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             MaxLines="1" />
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding OverlayProgress}"
                                           Classes="muted"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                              </Grid>
                            </Border>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2"
                      x:Name="landingProjectLibraryHeader"
                      Margin="0,2,0,0">
                  <TextBlock Text="Recent Projects"
                             Classes="heading"
                             VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="3"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="landingProjectList"
                           IsVisible="False">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="surface"
                                Padding="12"
                                Margin="0,0,0,8">
                          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    IsVisible="{Binding ShowStatusBadge}"
                                    Background="{DynamicResource ZetlSurfaceAltBrush}"
                                    CornerRadius="10"
                                    Padding="8,1">
                              <TextBlock Text="{Binding Status}"
                                         Classes="muted"
                                         FontSize="11" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Detail}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxLines="1" />
                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,Auto"
                                  Margin="0,6,0,0">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding ActivityText}"
                                         Classes="muted"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         MaxLines="1"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Open"
                                      MinWidth="54"
                                      Padding="10,3"
                                      PointerPressed="OnProjectCardActionPointerPressed"
                                      Click="OnProjectCardOpenClick" />
                            </Grid>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2"
                  x:Name="landingLowerContent"
                  RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="10">
              <Grid x:Name="landingModeToggle"
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    IsVisible="False">
                <StackPanel Grid.Column="0"
                            Spacing="2"
                            VerticalAlignment="Center">
                  <TextBlock x:Name="landingWorkspaceTitle"
                             Text="Projects"
                             FontSize="22"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="landingWorkspaceSubtitle"
                             Text="Choose a project to open."
                             Classes="muted"
                             FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <Button x:Name="landingProjectsButton"
                          Content="Projects"
                          Padding="16,5" />
                  <Button x:Name="landingTemplatesButton"
                          Content="Templates"
                          Padding="16,5" />
                </StackPanel>
              </Grid>

              <Grid x:Name="landingLowerActionRow"
                    Grid.Row="1"
                    ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0"
                            x:Name="landingProjectArchiveToggle"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8"
                            IsVisible="False">
                  <Button x:Name="landingCurrentProjectsButton"
                          Content="Current"
                          Padding="16,5" />
                  <Button x:Name="landingArchivedProjectsButton"
                          Content="Archived"
                          Padding="16,5" />
                </StackPanel>
                <StackPanel Grid.Column="0"
                            x:Name="landingTemplateTypeToggle"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8"
                            IsVisible="False">
                  <Button x:Name="landingCaptureButton"
                          Content="Capture"
                          Padding="16,5" />
                  <Button x:Name="landingConsumableButton"
                          Content="Consumable"
                          Padding="16,5" />
                </StackPanel>
                <Button Grid.Column="2"
                        x:Name="landingNewTemplateButton"
                        Content="+ New Template"
                        Padding="16,5"
                        HorizontalAlignment="Right"
                        IsVisible="False"
                        Click="OnNewTemplateClick" />
                <Button Grid.Column="3"
                        x:Name="landingNewCreationButton"
                        Content="+ New Creation Type"
                        Padding="16,5"
                        HorizontalAlignment="Right"
                        IsVisible="False"
                        Click="OnNewCreationClick" />
              </Grid>

              <ListBox x:Name="landingProjectWorkspaceList"
                       Grid.Row="2"
                       IsVisible="False">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="surface"
                            Width="330"
                            Height="220"
                            Padding="14"
                            Margin="0,0,12,12">
                      <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding ActivityText}"
                                     Classes="muted"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                          <Border Grid.Column="1"
                                  IsVisible="{Binding ShowStatusBadge}"
                                  Background="{DynamicResource ZetlSurfaceAltBrush}"
                                  CornerRadius="10"
                                  Padding="10,2">
                            <TextBlock Text="{Binding Status}"
                                       Classes="muted"
                                       FontSize="12" />
                          </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="5">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="18"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     MaxLines="1" />
                          <TextBlock Text="{Binding PreviewText}"
                                     Classes="muted"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="6">
                          <Button Grid.Column="0"
                                  Content="Open"
                                  MinWidth="54"
                                  Padding="10,4"
                                  HorizontalAlignment="Left"
                                  PointerPressed="OnProjectCardActionPointerPressed"
                                  Click="OnProjectCardOpenClick" />
                          <Grid Grid.Column="1"
                                ColumnDefinitions="Auto,Auto">
                            <Button Grid.Column="0"
                                    Content="{Binding SetActiveActionLabel}"
                                    IsEnabled="{Binding CanSetActive}"
                                    Padding="10,4"
                                    CornerRadius="4,0,0,4"
                                    PointerPressed="OnProjectCardActionPointerPressed"
                                    Click="OnProjectCardPinClick" />
                            <Button Grid.Column="1"
                                    Content="▾"
                                    IsEnabled="{Binding CanSetAlternateActive}"
                                    Padding="8,4"
                                    CornerRadius="0,4,4,0"
                                    PointerPressed="OnProjectCardActionPointerPressed">
                              <Button.Flyout>
                                <MenuFlyout>
                                  <MenuItem Header="Set as Alternate"
                                            IsEnabled="{Binding CanSetAlternateActive}"
                                            Tag="{Binding}"
                                            Click="OnProjectCardSetAlternateClick" />
                                </MenuFlyout>
                              </Button.Flyout>
                            </Button>
                          </Grid>
                          <Button Grid.Column="2"
                                  Content="..."
                                  MinWidth="34"
                                  Padding="8,4"
                                  PointerPressed="OnProjectCardActionPointerPressed"
                                  HorizontalAlignment="Right">
                            <Button.Flyout>
                              <MenuFlyout>
                                <MenuItem Header="{Binding StatusActionLabel}"
                                          Click="OnProjectCardStatusClick" />
                                <MenuItem Header="Use Temporarily"
                                          IsVisible="{Binding CanUseTemporarily}"
                                          Click="OnProjectCardUseTemporarilyClick" />
                                <MenuItem Header="Rename"
                                          Click="OnProjectCardRenameClick" />
                                <MenuItem Header="Delete"
                                          Click="OnProjectCardDeleteClick" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            <!-- An ItemsControl, not a ListBox: template cards act through their
                 Use Template button, so the cards must never show selection or
                 focus chrome. -->
            <ScrollViewer x:Name="landingTemplateList"
                          Grid.Row="2"
                          Margin="0,0,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False">
              <ItemsControl x:Name="landingTemplateItems">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="surface"
                            Width="450"
                            Height="330"
                            Padding="16"
                            Margin="8">
                      <Grid RowDefinitions="170,*,Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource ZetlSurfaceAltBrush}"
                                CornerRadius="4"
                                Padding="14">
                          <TextBlock Text="{Binding Kind}"
                                     Classes="muted"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="20"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                          <Button Content="Edit"
                                  Padding="12,5"
                                  Click="OnEditTemplateClick" />
                          <Button Content="Duplicate"
                                  Padding="12,5"
                                  Click="OnDuplicateTemplateClick" />
                          <Button Content="Delete"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnDeleteTemplateClick" />
                          <Button Content="Use"
                                  Padding="12,5"
                                  Click="OnUseTemplateClick" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="landingCreationList"
                          Grid.Row="2"
                          Margin="0,0,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False">
              <ItemsControl x:Name="landingCreationItems">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="surface"
                            Width="450"
                            Height="330"
                            Padding="16"
                            Margin="8">
                      <Grid RowDefinitions="170,*,Auto">
                        <Border Grid.Row="0"
                                Background="{DynamicResource ZetlSurfaceAltBrush}"
                                CornerRadius="4"
                                Padding="14">
                          <TextBlock Text="{Binding Kind}"
                                     Classes="muted"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     FontSize="20"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                          <Button Content="Edit"
                                  Padding="12,5"
                                  Click="OnEditCreationClick" />
                          <Button Content="Duplicate"
                                  Padding="12,5"
                                  Click="OnDuplicateCreationClick" />
                          <Button Content="Delete"
                                  Padding="12,5"
                                  IsVisible="{Binding IsUser}"
                                  Click="OnDeleteCreationClick" />
                          <Button Content="Use"
                                  Padding="12,5"
                                  Click="OnUseCreationClick" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Grid>

            <Button Grid.Column="2"
                    x:Name="landingCreateButton"
                    Content="Create"
                    Padding="18,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsVisible="False" />
          </Grid>

          <Grid x:Name="projectView"
                IsVisible="False"
                RowDefinitions="Auto,14,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,260,Auto,Auto"
                  ColumnSpacing="10">
              <StackPanel Grid.Column="0"
                          MaxWidth="430"
                          Orientation="Horizontal"
                          Spacing="10"
                          VerticalAlignment="Center">
                <TextBlock x:Name="projectTitle"
                           Classes="title"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="projectSummary"
                           Classes="muted"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <Button x:Name="viewModeListButton"
                        Content="List"
                        Padding="14,5"
                        CornerRadius="4,0,0,4"
                        Classes="view-format-active" />
                <Button x:Name="viewModeBoardButton"
                        Content="Board"
                        Padding="14,5"
                        CornerRadius="0,4,4,0" />
              </StackPanel>
              <TextBox Grid.Column="2"
                       x:Name="searchBox"
                       Watermark="Search slips"
                       VerticalAlignment="Center" />
              <Button Grid.Column="3"
                      x:Name="filtersButton"
                      Content="Filters ▾"
                      Padding="14,5"
                      VerticalAlignment="Center">
                <Button.Flyout>
                  <Flyout>
                    <Border Classes="surface" Padding="14" Width="280">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Filter slips" Classes="heading" />
                        <StackPanel Spacing="4">
                          <TextBlock Text="Source" Classes="muted" FontSize="12" />
                          <ComboBox x:Name="sourceFilterBox">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Session" Classes="muted" FontSize="12" />
                          <ComboBox x:Name="sessionFilterBox">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Captured" Classes="muted" FontSize="12" />
                          <ComboBox x:Name="dateFilterBox">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Type" Classes="muted" FontSize="12" />
                          <ComboBox x:Name="typeFilterBox">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="4"
                      x:Name="closeProjectButton"
                      Content="Close Project"
                      Padding="14,5"
                      VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="mainColumnsGrid" Grid.Row="2" ColumnDefinitions="300,8,*,8,360">
              <Border x:Name="treePaneBorder" Grid.Column="0"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0"
                               Text="Buckets &amp; slips"
                               Classes="heading"
                               VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="viewDeletedButton"
                                  Content="Deleted"
                                  Padding="10,3"
                                  ToolTip.Tip="Show deleted slips to restore them" />
                    <Button Grid.Column="2"
                            x:Name="newSlipButton"
                            Content="+ Slip"
                            Padding="10,3" />
                  </Grid>
                  <!-- Insert bar for structural (Kastn-only) elements Zetl ignores. Holds
                       Divider now; Group / Table / LaTeX will join it here. -->
                  <StackPanel Grid.Row="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              Margin="0,0,0,8">
                    <TextBlock Text="Insert"
                               Classes="muted"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button x:Name="insertDividerButton"
                            Content="— Divider"
                            Padding="10,3"
                            ToolTip.Tip="Insert a divider after the selected slip" />
                    <Button x:Name="insertGroupButton"
                            Content="▢ Group"
                            Padding="10,3"
                            ToolTip.Tip="Insert a group container — drag slips or buckets into it" />
                  </StackPanel>
                  <TreeView Grid.Row="2" x:Name="projectTree" SelectionMode="Multiple">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                      </Style>
                      <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                        <Setter Property="Content" Value="›" />
                        <Setter Property="FontFamily" Value="{DynamicResource ZetlMonoFontFamily}" />
                        <Setter Property="FontSize" Value="15" />
                      </Style>
                      <Style Selector="TreeViewItem:expanded /template/ ToggleButton#PART_ExpandCollapseChevron">
                        <Setter Property="Content" Value="⌄" />
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                              ColumnSpacing="6"
                              MinWidth="225"
                              Tag="treeRow"
                              Background="Transparent"
                              Opacity="{Binding NodeOpacity}">
                          <Viewbox Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPlainBucket}"
                                   ToolTip.Tip="Bucket">
                            <Path Stroke="{DynamicResource ZetlAccentBrush}"
                                  StrokeThickness="1.7"
                                  Data="M2 5h7l2 2h11v12H2z" />
                          </Viewbox>
                          <Viewbox Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsContainerBucket}"
                                   ToolTip.Tip="Container (drag slips or buckets in)">
                            <Path Stroke="{DynamicResource ZetlAccentBrush}"
                                  StrokeThickness="1.7"
                                  Data="M3 4h18v16H3z M3 9h18" />
                          </Viewbox>
                          <Viewbox Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsText}"
                                   ToolTip.Tip="Text slip">
                            <Path Stroke="{DynamicResource ZetlMutedTextBrush}"
                                  StrokeThickness="1.7"
                                  Data="M5 2h10l4 4v16H5z M15 2v5h4 M8 11h8 M8 15h8" />
                          </Viewbox>
                          <Viewbox Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPicture}"
                                   ToolTip.Tip="Picture slip">
                            <Path Stroke="{DynamicResource ZetlMutedTextBrush}"
                                  StrokeThickness="1.7"
                                  Data="M3 4h18v16H3z M6 16l4-4 3 3 2-2 3 3 M16 8h.01" />
                          </Viewbox>
                          <Viewbox Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsStructural}"
                                   ToolTip.Tip="Structural element">
                            <Path Stroke="{DynamicResource ZetlAccentBrush}"
                                  StrokeThickness="1.7"
                                  Data="M3 12h18" />
                          </Viewbox>
                          <Button Grid.Column="1"
                                  Width="26"
                                  Height="24"
                                  Padding="4"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsEnabled="{Binding CanToggleVisibility}"
                                  ToolTip.Tip="{Binding VisibilityToolTip}"
                                  Click="OnTreeVisibilityClick">
                            <Grid>
                              <Viewbox Width="16"
                                       Height="16"
                                       IsVisible="{Binding ShowOpenEye}">
                                <Path Stroke="{DynamicResource ZetlMutedTextBrush}"
                                      StrokeThickness="1.8"
                                      Data="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z M9 12a3 3 0 1 0 6 0 3 3 0 1 0-6 0" />
                              </Viewbox>
                              <Viewbox Width="16"
                                       Height="16"
                                       IsVisible="{Binding ShowClosedEye}">
                                <Path Stroke="{DynamicResource ZetlMutedTextBrush}"
                                      StrokeThickness="1.8"
                                      Data="M9.88 9.88a3 3 0 1 0 4.24 4.24M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61M2 2l20 20" />
                              </Viewbox>
                              <Ellipse Width="5"
                                       Height="5"
                                       Fill="{DynamicResource ZetlAccentBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       IsVisible="{Binding IsVisibilityMixed}"
                                       ToolTip.Tip="Some slips are hidden" />
                            </Grid>
                          </Button>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Label}"
                                     Margin="0,3"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Border Grid.Column="3"
                                  IsVisible="{Binding IsBucket}"
                                  Background="{DynamicResource ZetlSurfaceBrush}"
                                  CornerRadius="8"
                                  Padding="7,2"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountLabel}"
                                       Classes="muted"
                                       FontSize="10" />
                          </Border>
                          <!-- Live drop target marker during drag-and-drop (drop into). -->
                          <Border Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  IsHitTestVisible="False"
                                  BorderThickness="3,0,0,0"
                                  BorderBrush="{DynamicResource ZetlAccentBrush}"
                                  Background="{DynamicResource ZetlSurfaceBrush}"
                                  CornerRadius="2"
                                  Margin="-4,0,0,0"
                                  Opacity="0.6"
                                  IsVisible="{Binding IsDropTarget}" />
                          <!-- Insertion lines during a bucket reorder drag (drop between). -->
                          <Border Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  IsHitTestVisible="False"
                                  Height="2"
                                  VerticalAlignment="Top"
                                  Background="{DynamicResource ZetlAccentBrush}"
                                  IsVisible="{Binding ShowDropBefore}" />
                          <Border Grid.Column="0"
                                  Grid.ColumnSpan="4"
                                  IsHitTestVisible="False"
                                  Height="2"
                                  VerticalAlignment="Bottom"
                                  Background="{DynamicResource ZetlAccentBrush}"
                                  IsVisible="{Binding ShowDropAfter}" />
                        </Grid>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                  <TextBox Grid.Row="3"
                           x:Name="bucketNameBox"
                           Watermark="Bucket name"
                           Margin="0,10,0,0" />
                  <ComboBox Grid.Row="4"
                            x:Name="bucketRenderKindBox"
                            Margin="0,8,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Row="5"
                            x:Name="parentBucketBox"
                            Margin="0,8,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="6"
                             x:Name="parentBucketHintText"
                             Classes="muted"
                             FontSize="12"
                             Margin="0,4,0,0" />
                  <StackPanel Grid.Row="7"
                              x:Name="bucketHeadingPanel"
                              Spacing="4"
                              Margin="0,8,0,0"
                              IsVisible="False">
                    <TextBlock Text="Heading style" Classes="muted" FontSize="12" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                      <ComboBox x:Name="bucketHeadingSizeBox" MinWidth="110" />
                      <ComboBox x:Name="bucketHeadingAlignBox" MinWidth="95" />
                      <CheckBox x:Name="bucketHeadingBoldCheck"
                                Content="Bold"
                                VerticalAlignment="Center" />
                    </WrapPanel>
                  </StackPanel>
                  <Grid Grid.Row="8"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="6"
                        Margin="0,8,0,0">
                    <Button Grid.Column="0" x:Name="addBucketButton" Content="+ Bucket" />
                    <Button Grid.Column="1" x:Name="saveBucketButton" Content="Save" />
                    <Button Grid.Column="2" x:Name="deleteBucketButton" Content="Delete" />
                  </Grid>
                </Grid>
              </Border>

              <GridSplitter x:Name="leftSplitter" Grid.Column="1" Width="8" ResizeDirection="Columns" />

              <Border Grid.Column="2"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Panel>
                  <Grid x:Name="viewerPanel"
                        RowDefinitions="Auto,Auto,*"
                        IsVisible="True">
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="View" Classes="heading" VerticalAlignment="Center" />
                        <ComboBox x:Name="viewPickerBox" Width="150" VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="copyViewButton" Content="Copy" Padding="12,3" VerticalAlignment="Center" />
                        <Button x:Name="exportViewButton" Content="Export…" Padding="12,3" VerticalAlignment="Center" />
                        <Button x:Name="manageViewsButton" Content="Manage ▾" Padding="12,3" VerticalAlignment="Center">
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem x:Name="newViewMenuItem" Header="New view…" />
                              <MenuItem x:Name="editViewSettingsMenuItem" Header="Edit view…" />
                              <MenuItem x:Name="deleteViewMenuItem" Header="Delete view" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               x:Name="viewerSummaryText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,2,0,8" />
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="viewerDocumentScroll"
                                      VerticalScrollBarVisibility="Auto">
                          <StackPanel x:Name="viewerDocumentPanel" Spacing="6" Margin="8" />
                        </ScrollViewer>
                    </Grid>
                  </Grid>

                  <Grid x:Name="boardPanel"
                        RowDefinitions="Auto,*"
                        IsVisible="False">
                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="Board" Classes="heading" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="boardScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                      <StackPanel x:Name="boardColumnsPanel"
                                  Orientation="Horizontal"
                                  Spacing="12" />
                    </ScrollViewer>
                  </Grid>
                </Panel>
              </Border>

              <GridSplitter x:Name="rightSplitter" Grid.Column="3" Width="8" ResizeDirection="Columns" />

              <Border x:Name="rightPaneBorder"
                      Grid.Column="4"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Grid.Row="0" Text="Detail" Classes="heading" />
                  <StackPanel Grid.Row="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              Margin="0,8,0,10">
                    <Button x:Name="detailEditorButton" Content="Editor" Padding="16,4" />
                    <Button x:Name="detailDetailsButton" Content="Details" Padding="16,4" />
                  </StackPanel>
                  <Grid Grid.Row="2">
                    <Grid x:Name="editorPanel"
                          RowDefinitions="Auto,Auto,*,Auto,Auto">
                      <TextBlock Grid.Row="0"
                                 x:Name="slipMetadataText"
                                 Classes="muted"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,8" />
                      <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <WrapPanel x:Name="formatToolbar"
                                   Orientation="Horizontal">
                          <WrapPanel.Styles>
                            <!-- WrapPanel has no Spacing; give each control a small
                                 gap so the toolbar reads cleanly when it wraps. -->
                            <Style Selector="WrapPanel#formatToolbar > Button">
                              <Setter Property="Margin" Value="0,0,4,4" />
                            </Style>
                          </WrapPanel.Styles>
                          <Button x:Name="boldButton" Content="B" FontWeight="Bold" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Bold" />
                          <Button x:Name="italicButton" Content="I" FontStyle="Italic" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Italic" />
                          <Button x:Name="strikeButton" Content="S" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Strikethrough" />
                          <Button x:Name="codeButton" Content="&lt;/&gt;" Padding="9,3" Focusable="False" ToolTip.Tip="Inline code" />
                          <Button x:Name="linkButton" Content="Link" Padding="9,3" Focusable="False" ToolTip.Tip="Web link" />
                          <Button x:Name="wikiLinkButton" Content="[[ Link ]]" Padding="9,3" Focusable="False" ToolTip.Tip="Link to another slip" />
                          <Border Width="1" Background="{DynamicResource ZetlBorderBrush}" Margin="4,2" />
                          <Button x:Name="bulletListButton" Content="•" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Bullet list" />
                          <Button x:Name="numberListButton" Content="1." Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Numbered list" />
                          <Button x:Name="taskListButton" Content="☑" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Checklist" />
                          <Border Width="1" Background="{DynamicResource ZetlBorderBrush}" Margin="4,2" />
                          <Button x:Name="headingButton" Content="H" Padding="9,3" MinWidth="30" Focusable="False" ToolTip.Tip="Sub-heading" />
                          <Button x:Name="quoteButton" Content="Quote" Padding="9,3" Focusable="False" ToolTip.Tip="Blockquote" />
                          <Button x:Name="codeBlockButton" Content="Code" Padding="9,3" Focusable="False" ToolTip.Tip="Code block" />
                          <Border Width="1" Background="{DynamicResource ZetlBorderBrush}" Margin="4,2" />
                          <TextBlock Text="Align" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                          <Button x:Name="alignLeftButton" Content="Left" Padding="9,3" ToolTip.Tip="Align left" />
                          <Button x:Name="alignCenterButton" Content="Center" Padding="9,3" ToolTip.Tip="Align center" />
                          <Button x:Name="alignRightButton" Content="Right" Padding="9,3" ToolTip.Tip="Align right" />
                        </WrapPanel>
                        <!-- Advisory when the selected view's Copy/Export artifact does
                             not carry the formatting the always-rich reader shows. -->
                        <TextBlock x:Name="formatFidelityNote"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="False"
                                   Margin="0,4,0,0" />
                        <CheckBox x:Name="ignoreBucketRenderKindCheck"
                                  Content="Ignore bucket style for this slip"
                                  FontSize="12"
                                  Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBox Grid.Row="2"
                               x:Name="slipEditor"
                               MinHeight="140"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               IsEnabled="False" />
                      <Border Grid.Row="3"
                              x:Name="conflictPanel"
                              IsVisible="False"
                              BorderBrush="{DynamicResource KastnOfflineBrush}"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="10"
                              Margin="0,10,0,0">
                        <Grid RowDefinitions="Auto,Auto,90,Auto,90,Auto">
                          <TextBlock Grid.Row="0"
                                     Text="This slip changed in Zetl while you were editing."
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Row="1" Text="Your version" Classes="muted" Margin="0,8,0,3" />
                          <TextBox Grid.Row="2"
                                   x:Name="localConflictText"
                                   IsReadOnly="True"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap" />
                          <TextBlock Grid.Row="3" Text="Current Zetl version" Classes="muted" Margin="0,8,0,3" />
                          <TextBox Grid.Row="4"
                                   x:Name="remoteConflictText"
                                   IsReadOnly="True"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap" />
                          <StackPanel Grid.Row="5"
                                      Orientation="Horizontal"
                                      HorizontalAlignment="Right"
                                      Spacing="8"
                                      Margin="0,8,0,0">
                            <Button x:Name="useZetlButton" Content="Use Zetl Version" />
                            <Button x:Name="keepMineButton" Content="Keep Mine" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Grid Grid.Row="4"
                            RowDefinitions="Auto,Auto"
                            Margin="0,10,0,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <ComboBox Grid.Column="0" x:Name="moveBucketBox">
                            <ComboBox.ItemTemplate>
                              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Grid.Column="1" x:Name="moveSlipButton" Content="Move" />
                          <Button Grid.Column="2" x:Name="restoreSlipButton" Content="Restore" />
                        </Grid>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6"
                                    Margin="0,8,0,0">
                          <Button x:Name="deleteSlipButton" Content="Delete" />
                          <Button x:Name="saveSlipButton" Content="Save" />
                        </StackPanel>
                      </Grid>
                    </Grid>

                    <ScrollViewer x:Name="inspectorPanel"
                                  IsVisible="False"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel x:Name="slipInspectorFieldsPanel" Spacing="8" />
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="templateEditorView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,14,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="templateEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      x:Name="saveTemplateButton"
                      Content="Save Template"
                      Padding="14,5" />
              <Button Grid.Column="2"
                      x:Name="cancelTemplateButton"
                      Content="Cancel"
                      Padding="14,5" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="2*,12,*,12,Auto" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Template name" Classes="muted" FontSize="12" />
                <TextBox x:Name="templateNameBox" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Category" Classes="muted" FontSize="12" />
                <TextBox x:Name="templateCategoryBox" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Type" Classes="muted" FontSize="12" />
                <ComboBox x:Name="templateTypeBox" Width="150" />
                <CheckBox x:Name="templateTemporaryBox"
                          Content="Temporary"
                          Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Description" Classes="muted" FontSize="12" />
              <TextBox x:Name="templateDescriptionBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Height="48" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       x:Name="templateErrorText"
                       Foreground="#E5484D"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />

            <Grid Grid.Row="5" ColumnDefinitions="260,8,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Row="0" Text="Buckets" Classes="heading" Margin="0,0,0,8" />
                  <ListBox Grid.Row="1" x:Name="templateBucketList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   Margin="4,5"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid Grid.Row="2"
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="6"
                        Margin="0,8,0,0">
                    <Button Grid.Column="0" x:Name="templateAddBucketButton" Content="Add" />
                    <Button Grid.Column="1" x:Name="templateBucketUpButton" Content="↑" />
                    <Button Grid.Column="2" x:Name="templateBucketDownButton" Content="↓" />
                    <Button Grid.Column="3" x:Name="templateDeleteBucketButton" Content="Del" />
                  </Grid>
                </Grid>
              </Border>

              <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

              <Border Grid.Column="2"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid>
                  <TextBlock x:Name="templateBucketEmptyHint"
                             Classes="muted"
                             Text="Add or select a bucket to edit its settings."
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                  <Grid x:Name="templateBucketEditor"
                        IsVisible="False"
                        RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Bucket" Classes="heading" />
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                      <TextBlock Text="Bucket name" Classes="muted" FontSize="12" />
                      <TextBox x:Name="templateBucketNameBox" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*,12,Auto" Margin="0,8,0,0">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Kind" Classes="muted" FontSize="12" />
                        <ComboBox x:Name="templateBucketKindBox" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Compile mode" Classes="muted" FontSize="12" />
                        <ComboBox x:Name="templateBucketCompileBox" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="TSV rows" Classes="muted" FontSize="12" />
                        <NumericUpDown x:Name="templateBucketTsvBox"
                                       Minimum="1"
                                       Maximum="100"
                                       Increment="1"
                                       FormatString="0"
                                       Width="120" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                      <TextBlock Text="Starting text / TSV headers (one per line)"
                                 Classes="muted"
                                 FontSize="12" />
                      <TextBox x:Name="templateBucketStartBox"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Height="70" />
                    </StackPanel>
                    <StackPanel Grid.Row="4"
                                x:Name="templateSeedsPanel"
                                Spacing="4"
                                Margin="0,10,0,0">
                      <TextBlock Text="Starter cards — one per line; use Title :: body (body may be blank)"
                                 Classes="muted"
                                 FontSize="12" />
                      <TextBox x:Name="templateBucketSeedsBox"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="viewEditorView"
                IsVisible="False"
                RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="viewEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="saveViewSettingsButton" Content="Save View" Padding="14,5" />
              <Button Grid.Column="2" x:Name="cancelViewSettingsButton" Content="Cancel" Padding="14,5" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="3*,18,2*">
              <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,0,8,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="View name" Classes="muted" FontSize="12" />
                  <TextBox x:Name="viewNameBox" />
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="Choose an output format" Classes="heading" />
                  <TextBlock Text="Quick compile keeps captured text literal. Document formats render Markdown and pictures for sharing."
                             Classes="muted" TextWrapping="Wrap" />

                  <Border Classes="surface" Padding="12">
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Quick compile" FontWeight="SemiBold" />
                        <TextBlock Text="Fast, literal output for pasting and data entry."
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <Grid Grid.Column="1" ColumnDefinitions="*,8,*,8,*">
                        <Button Grid.Column="0" x:Name="viewFormattedKindButton" Content="Formatted" Padding="12,8" />
                        <Button Grid.Column="2" x:Name="viewPlainKindButton" Content="Plain" Padding="12,8" />
                        <Button Grid.Column="4" x:Name="viewTsvKindButton" Content="TSV" Padding="12,8" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="surface" Padding="12">
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Document" FontWeight="SemiBold" />
                        <TextBlock Text="Rich output with formatting, links, lists, and pictures."
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <Grid Grid.Column="1" ColumnDefinitions="*,8,*,8,*">
                        <Button Grid.Column="0" x:Name="viewMarkdownKindButton" Content="Markdown" Padding="12,8" />
                        <Button Grid.Column="2" x:Name="viewHtmlKindButton" Content="HTML" Padding="12,8" />
                        <Button Grid.Column="4" x:Name="viewPdfKindButton" Content="PDF" Padding="12,8" />
                      </Grid>
                    </Grid>
                  </Border>
                  <ComboBox x:Name="viewKindBox" IsVisible="False" />
                </StackPanel>

                <StackPanel x:Name="viewDocumentSettingsPanel" Spacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Document title" Classes="muted" FontSize="12" />
                    <TextBox x:Name="viewTitleBox"
                             Watermark="Project name"
                             HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="viewShowTitleCheck"
                              Content="Show title in exported document" />
                    <TextBlock Text="Title appears in the exported / copied Markdown, HTML, and PDF."
                               Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,16,Auto">
                    <!-- List style is now a per-note property set from the editor
                         toolbar, so the view no longer carries a bucket-wide slip
                         style. The box is kept (hidden) only to preserve wiring. -->
                    <StackPanel Grid.Column="0" Spacing="4" IsVisible="False">
                      <TextBlock Text="Slip style" Classes="muted" FontSize="12" />
                      <ComboBox x:Name="viewListStyleBox" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              x:Name="viewNumberHeadingsCheck"
                              Content="Number headings (1, 1.1)"
                              VerticalAlignment="Bottom" />
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="viewTsvPanel" Spacing="4">
                  <TextBlock Text="Items per TSV row" Classes="muted" FontSize="12" />
                  <NumericUpDown x:Name="viewTsvRowBox"
                                 Minimum="1" Maximum="100" Increment="1" FormatString="0"
                                 Width="160" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Description" Classes="muted" FontSize="12" />
                  <TextBox x:Name="viewDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Structure" Classes="heading" />
                  <TextBlock Text="Choose whether this view follows the project as-is or assembles named sections from its buckets."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="viewAllBucketsButton" Content="All buckets" Padding="14,6" />
                    <Button x:Name="viewCustomSectionsButton" Content="Custom sections" Padding="14,6" />
                  </StackPanel>
                  <Border x:Name="viewAllBucketsPanel" Classes="surface" Padding="12" Margin="0,4,0,0">
                    <TextBlock Text="Every bucket renders under its own name and in its project order. This view can be used with any project."
                               Classes="muted" TextWrapping="Wrap" />
                  </Border>
                  <StackPanel x:Name="viewCustomSectionsPanel" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="Rename, merge, reorder, or omit buckets. This structure belongs to the current project."
                               Classes="muted" TextWrapping="Wrap" />
                    <StackPanel x:Name="viewSectionEditorPanel" Spacing="8" />
                    <Button x:Name="addViewSectionButton" Content="+ Add section"
                            Padding="12,5" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>

                <TextBlock x:Name="viewErrorText" Foreground="#E5484D"
                           TextWrapping="Wrap" IsVisible="False" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Views render the current project's slips. Slips stay the source of truth; a view never changes them." />
                </StackPanel>
              </ScrollViewer>

              <Border Grid.Column="2" Classes="surface" Padding="14">
                <Grid RowDefinitions="Auto,10,*">
                  <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="Live preview" Classes="heading" />
                    <TextBlock x:Name="viewLivePreviewSummary" Classes="muted" FontSize="12"
                               Text="Current project · unsaved view" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="viewLivePreviewPanel" Spacing="5" Margin="0,0,6,0" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="creationEditorView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         x:Name="creationEditorTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="saveCreationButton" Content="Save" Padding="14,5" />
              <Button Grid.Column="2" x:Name="cancelCreationButton" Content="Cancel" Padding="14,5" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Creation type name" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationNameBox" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Category" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationCategoryBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Template" Classes="muted" FontSize="12" />
              <ComboBox x:Name="creationTemplateBox" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Default view" Classes="muted" FontSize="12" />
              <ComboBox x:Name="creationViewBox" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Description" Classes="muted" FontSize="12" />
              <TextBox x:Name="creationDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            </StackPanel>

            <TextBlock Grid.Row="6"
                       x:Name="creationErrorText"
                       Foreground="#E5484D"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            BorderBrush="{DynamicResource ZetlBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,9">
      <Grid ColumnDefinitions="Auto,8,*,Auto">
        <Ellipse Grid.Column="0"
                 x:Name="connectionIndicator"
                 Width="9" Height="9"
                 Fill="{DynamicResource KastnOfflineBrush}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   x:Name="statusText"
                   Text="Connecting to Zetl..."
                   Classes="muted"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Column="3"
                     x:Name="connectionProgress"
                     Width="90"
                     IsIndeterminate="True"
                     ShowProgressText="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
