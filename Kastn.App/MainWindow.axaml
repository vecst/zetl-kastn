<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KASTN.MainWindow"
        Width="1380" Height="820"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Title="Kastn">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem x:Name="refreshMenuItem" Header="_Refresh" InputGesture="F5" />
        <MenuItem x:Name="closeProjectMenuItem" Header="_Close Project" InputGesture="Ctrl+W" />
        <MenuItem x:Name="deleteProjectMenuItem" Header="_Delete Project" />
        <Separator />
        <MenuItem x:Name="exitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="newSlipMenuItem" Header="_New Slip" InputGesture="Ctrl+N" />
        <Separator />
        <MenuItem x:Name="saveSlipMenuItem" Header="_Save Slip" InputGesture="Ctrl+S" />
        <MenuItem x:Name="deleteSlipMenuItem" Header="_Delete Slip" />
        <Separator />
        <MenuItem x:Name="focusSearchMenuItem" Header="_Find" InputGesture="Ctrl+F" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="viewerModeMenuItem" Header="_Edit View" InputGesture="Ctrl+Shift+E" />
        <Separator />
        <MenuItem x:Name="focusProjectsMenuItem" Header="Focus Project _Cards" />
        <MenuItem x:Name="focusBucketsMenuItem" Header="Focus _Buckets" />
        <MenuItem x:Name="focusSlipsMenuItem" Header="Focus _Main View" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="aboutMenuItem" Header="_About Kastn" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1"
            x:Name="offlineBanner"
            Background="{DynamicResource KastnOfflineBrush}"
            Padding="12,8"
            IsVisible="False">
      <TextBlock Foreground="#22180C"
                 FontWeight="SemiBold"
                 Text="Zetl is offline. Your last snapshot remains readable; editing resumes after reconnect." />
    </Border>

    <Grid Grid.Row="2" Margin="16">
      <Border Classes="surface" Padding="18">
        <Grid>
          <StackPanel x:Name="emptyState"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="Kastn" Classes="title" HorizontalAlignment="Center" />
            <TextBlock x:Name="emptyStateText"
                       Text="Connecting to Zetl..."
                       Classes="muted"
                       TextAlignment="Center"
                       MaxWidth="440" />
            <StackPanel x:Name="landingModeToggle"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,4,0,0"
                        IsVisible="False">
              <Button x:Name="landingProjectsButton"
                      Content="Projects"
                      Padding="16,5" />
              <Button x:Name="landingTemplatesButton"
                      Content="Templates"
                      Padding="16,5" />
            </StackPanel>
            <ListBox x:Name="landingProjectList"
                     Width="880"
                     MaxHeight="520"
                     Margin="0,16,0,0"
                     IsVisible="False">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="surface"
                          Width="300"
                          Height="220"
                          Padding="12"
                          Margin="8">
                    <Grid RowDefinitions="102,*,Auto">
                      <Border Grid.Row="0"
                              Background="{DynamicResource ZetlSurfaceAltBrush}"
                              CornerRadius="4"
                              Padding="10">
                        <TextBlock Text="{Binding PreviewText}"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="4" />
                      </Border>
                      <StackPanel Grid.Row="1"
                                  Margin="0,10,0,0"
                                  Spacing="3">
                        <TextBlock
                                 Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="16"
                                 TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   MaxLines="1" />
                        <TextBlock Text="{Binding ActivityText}"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="1" />
                      </StackPanel>
                      <TextBlock Grid.Row="2"
                                 Text="Open project"
                                 Classes="muted"
                                 FontSize="12"
                                 HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="landingTemplateList"
                     Width="880"
                     MaxHeight="520"
                     Margin="0,16,0,0"
                     IsVisible="False"
                     IsHitTestVisible="False">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="surface"
                          Width="300"
                          Height="220"
                          Padding="12"
                          Margin="8">
                    <Grid RowDefinitions="102,*,Auto">
                      <Border Grid.Row="0"
                              Background="{DynamicResource ZetlSurfaceAltBrush}"
                              CornerRadius="4"
                              Padding="10">
                        <TextBlock Text="{Binding Kind}"
                                   Classes="muted"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Row="1"
                                  Margin="0,10,0,0"
                                  Spacing="4">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                      </StackPanel>
                      <TextBlock Grid.Row="2"
                                 Text="Coming soon"
                                 Classes="muted"
                                 FontSize="12"
                                 HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Grid x:Name="projectView"
                IsVisible="False"
                RowDefinitions="Auto,Auto,14,Auto,14,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0"
                         x:Name="projectTitle"
                         Classes="title"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1"
                      x:Name="closeProjectButton"
                      Content="Close Project"
                      Padding="14,5" />
            </Grid>
            <TextBlock Grid.Row="1"
                       x:Name="projectSummary"
                       Classes="muted"
                       Margin="0,4,0,0" />

            <Grid Grid.Row="3" ColumnDefinitions="2*,12,*,12,*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Search" Classes="muted" FontSize="12" />
                <TextBox x:Name="searchBox" Watermark="Search slip text" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Source" Classes="muted" FontSize="12" />
                <ComboBox x:Name="sourceFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Session" Classes="muted" FontSize="12" />
                <ComboBox x:Name="sessionFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="6" Spacing="4">
                <TextBlock Text="Captured" Classes="muted" FontSize="12" />
                <ComboBox x:Name="dateFilterBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="5" ColumnDefinitions="260,8,*">
              <Border Grid.Column="0"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Text="Buckets" Classes="heading" Margin="0,0,0,8" />
                  <ListBox Grid.Row="1" x:Name="bucketList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}"
                                   Margin="4,5"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBox Grid.Row="2"
                           x:Name="bucketNameBox"
                           Watermark="Bucket name"
                           Margin="0,10,0,0" />
                  <ComboBox Grid.Row="3"
                            x:Name="parentBucketBox"
                            Margin="0,8,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="4"
                             x:Name="parentBucketHintText"
                             Classes="muted"
                             FontSize="12"
                             Margin="0,4,0,0" />
                  <Grid Grid.Row="5"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="6"
                        Margin="0,8,0,0">
                    <Button Grid.Column="0" x:Name="addBucketButton" Content="Add" />
                    <Button Grid.Column="1" x:Name="saveBucketButton" Content="Save" />
                    <Button Grid.Column="2" x:Name="deleteBucketButton" Content="Delete" />
                  </Grid>
                </Grid>
              </Border>

              <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" />

              <Border Grid.Column="2"
                      Background="{DynamicResource ZetlSurfaceAltBrush}"
                      CornerRadius="5"
                      Padding="12">
                <Grid>
                  <Grid x:Name="editorPanel"
                        IsVisible="False"
                        RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Editor" Classes="heading" />
                    <TextBlock Grid.Row="1"
                               x:Name="slipMetadataText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,2,0,8" />
                    <TextBox Grid.Row="2"
                             x:Name="slipEditor"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsEnabled="False" />
                    <Border Grid.Row="3"
                            x:Name="conflictPanel"
                            IsVisible="False"
                            BorderBrush="{DynamicResource KastnOfflineBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,0">
                      <Grid RowDefinitions="Auto,Auto,90,Auto,90,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="This slip changed in Zetl while you were editing."
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Your version" Classes="muted" Margin="0,8,0,3" />
                        <TextBox Grid.Row="2"
                                 x:Name="localConflictText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Current Zetl version" Classes="muted" Margin="0,8,0,3" />
                        <TextBox Grid.Row="4"
                                 x:Name="remoteConflictText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,8,0,0">
                          <Button x:Name="useZetlButton" Content="Use Zetl Version" />
                          <Button x:Name="keepMineButton" Content="Keep Mine" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Grid Grid.Row="4"
                          ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          Margin="0,10,0,0">
                      <ComboBox Grid.Column="0" x:Name="moveBucketBox">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" x:Name="moveSlipButton" Content="Move" />
                      <Button Grid.Column="2" x:Name="restoreSlipButton" Content="Restore" />
                      <Button Grid.Column="3" x:Name="deleteSlipButton" Content="Delete" />
                      <Button Grid.Column="4" x:Name="saveSlipButton" Content="Save" />
                    </Grid>
                  </Grid>
                  <Grid x:Name="viewerPanel"
                        RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,190,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="Read View" Classes="heading" />
                      <ComboBox Grid.Column="1"
                                x:Name="editViewMoveBucketBox"
                                IsVisible="False">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="2"
                              x:Name="moveSelectedViewButton"
                              Content="Move Selected"
                              Padding="12,3" />
                      <Button Grid.Column="3"
                              x:Name="newSlipButton"
                              Content="New"
                              Padding="12,3" />
                      <Button Grid.Column="4"
                              x:Name="editViewButton"
                              Content="Edit View"
                              Padding="12,3" />
                      <Button Grid.Column="5"
                              x:Name="saveViewButton"
                              Content="Save All"
                              Padding="12,3" />
                      <Button Grid.Column="6"
                              x:Name="cancelViewButton"
                              Content="Cancel"
                              Padding="12,3" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               x:Name="viewerSummaryText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,2,0,8" />
                    <TextBlock Grid.Row="2"
                               x:Name="editViewStatusText"
                               Classes="muted"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <Grid Grid.Row="3">
                      <TextBox x:Name="viewerTextBox"
                               AcceptsReturn="True"
                               IsReadOnly="True"
                               TextWrapping="Wrap"
                               ScrollViewer.VerticalScrollBarVisibility="Auto" />
                      <ScrollViewer x:Name="editViewScroll"
                                    IsVisible="False"
                                    VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="editableBlocksPanel" Spacing="10" />
                      </ScrollViewer>
                    </Grid>
                  </Grid>
                  <ListBox x:Name="slipList"
                           IsVisible="False"
                           SelectionMode="Multiple" />
                  <TextBlock x:Name="slipCountText" IsVisible="False" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3"
            BorderBrush="{DynamicResource ZetlBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,9">
      <Grid ColumnDefinitions="Auto,8,*,Auto">
        <Ellipse Grid.Column="0"
                 x:Name="connectionIndicator"
                 Width="9" Height="9"
                 Fill="{DynamicResource KastnOfflineBrush}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   x:Name="statusText"
                   Text="Connecting to Zetl..."
                   Classes="muted"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Column="3"
                     x:Name="connectionProgress"
                     Width="90"
                     IsIndeterminate="True"
                     ShowProgressText="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
